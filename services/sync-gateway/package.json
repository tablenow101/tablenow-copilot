{
  "name": "@tablenow/sync-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@tablenow/contracts": "workspace:*",
    "@tablenow/provider-adapters": "workspace:*",
    "dotenv": "^17.3.1",
    "fastify": "^5.12.1",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "rimraf": "^6.1.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
