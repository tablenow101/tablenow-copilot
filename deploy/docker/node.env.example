# Generate a private file with: ./scripts/init-node.sh direction@restaurant.fr
# Never commit the generated node.env file.
POSTGRES_ADMIN_PASSWORD=replace-with-64-random-hex-characters
POSTGRES_APP_PASSWORD=replace-with-another-64-random-hex-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-another-at-least-32-random-characters
TABLENOW_NODE_TOKEN=replace-with-a-private-node-token
TABLENOW_COMPUTER_NODE_TOKEN=replace-with-another-private-node-token

NODE_ENV=production
TABLENOW_STACK_ID=tablenow-v2
DATABASE_SCOPE=tablenow-v2
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:8080
PLATFORM_ADMIN_EMAIL=direction@restaurant.fr
SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=10
AUTH_FIXED_OTP=

EMAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=TableNow <access@tablenow.local>

AI_PROVIDER=deterministic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen3:8b
AI_MAX_DAILY_EUR=5
STORAGE_ENCRYPTION_KEY=replace-with-64-random-hex-characters

COMPUTER_HEADLESS=true
COMPUTER_POLL_MS=2000
COMPUTER_MAX_MODEL_STEPS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPUTER_MODEL=gpt-5.6

DATA_RETENTION_MONTHS=24
EXPORTS_DIR=/data/exports
WORKER_POLL_MS=2000
SYNC_ENABLED=false
SYNC_PORT=4100

# Replace before public release or signature.
TABLENOW_LEGAL_NAME=[DÉNOMINATION SOCIALE À COMPLÉTER]
TABLENOW_LEGAL_FORM=[FORME JURIDIQUE À COMPLÉTER]
TABLENOW_LEGAL_CAPITAL=[CAPITAL À COMPLÉTER]
TABLENOW_LEGAL_REGISTRATION=[SIREN / RCS À COMPLÉTER]
TABLENOW_LEGAL_ADDRESS=[SIÈGE SOCIAL À COMPLÉTER]
TABLENOW_LEGAL_DIRECTOR=[DIRECTEUR DE PUBLICATION À COMPLÉTER]
TABLENOW_LEGAL_HOST=TableNow Node local chez le client
