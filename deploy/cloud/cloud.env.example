# Copy through ./scripts/init-cloud.sh; never commit deploy/cloud/cloud.env.
API_DOMAIN=api.copilot.tablenow.io
PUBLIC_ORIGIN=https://copilot.tablenow.io
PLATFORM_ADMIN_EMAIL=direction@tablenow.io

NODE_ENV=production
TABLENOW_STACK_ID=tablenow-v2
DATABASE_SCOPE=tablenow-v2
LOG_LEVEL=info

POSTGRES_ADMIN_PASSWORD=generated-by-init-cloud
POSTGRES_APP_PASSWORD=generated-by-init-cloud
SESSION_SECRET=generated-by-init-cloud
OTP_PEPPER=generated-by-init-cloud
TABLENOW_NODE_TOKEN=generated-by-init-cloud
TABLENOW_COMPUTER_NODE_TOKEN=generated-by-init-cloud
STORAGE_ENCRYPTION_KEY=generated-by-init-cloud

SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=10
AUTH_FIXED_OTP=

EMAIL_TRANSPORT=smtp
SMTP_HOST=replace-with-real-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-real-smtp-user
SMTP_PASSWORD=replace-with-real-smtp-password
EMAIL_FROM=TableNow <access@tablenow.io>

AI_PROVIDER=deterministic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen3:8b
AI_MAX_DAILY_EUR=5

COMPUTER_HEADLESS=true
COMPUTER_POLL_MS=2000
COMPUTER_MAX_MODEL_STEPS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPUTER_MODEL=gpt-5.6

DATA_RETENTION_MONTHS=24
EXPORTS_DIR=/data/exports
WORKER_POLL_MS=2000
SYNC_ENABLED=false
SYNC_PORT=4100

TABLENOW_LEGAL_NAME=[DÉNOMINATION SOCIALE À COMPLÉTER]
TABLENOW_LEGAL_FORM=[FORME JURIDIQUE À COMPLÉTER]
TABLENOW_LEGAL_CAPITAL=[CAPITAL À COMPLÉTER]
TABLENOW_LEGAL_REGISTRATION=[SIREN / RCS À COMPLÉTER]
TABLENOW_LEGAL_ADDRESS=[SIÈGE SOCIAL À COMPLÉTER]
TABLENOW_LEGAL_DIRECTOR=[DIRECTEUR DE PUBLICATION À COMPLÉTER]
TABLENOW_LEGAL_HOST=Infrastructure cloud TableNow V2 séparée
