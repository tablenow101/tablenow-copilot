# Runtime
NODE_ENV=development
APP_ENV=development
TABLENOW_PREVIEW_SEED=false
LOG_LEVEL=info
TABLENOW_STACK_ID=tablenow-v2-test
DATABASE_SCOPE=tablenow-v2
PUBLIC_ORIGIN=http://localhost:8080
API_PORT=4000
WORKER_POLL_MS=2000

# PostgreSQL — use a distinct V2 database. Never point this at TableNow production.
DATABASE_URL=postgres://tablenow:tablenow_local_only@postgres:5432/tablenow_v2

# Passwordless authentication
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-another-at-least-32-random-characters
SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=10
# Development only. Production startup refuses a fixed OTP.
AUTH_FIXED_OTP=424242
PLATFORM_ADMIN_EMAIL=founder@tablenow.local

# Email: "smtp" for real sending, "log" for local development.
EMAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=TableNow <access@tablenow.local>

# Console and reverse proxy
NEXT_PUBLIC_API_BASE_URL=/api
CORE_API_INTERNAL_URL=http://core-api:4000

# Optional local/cloud agent provider (OpenAI-compatible or Ollama)
AI_PROVIDER=deterministic
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL=qwen3:8b
AI_MAX_DAILY_EUR=5

# 32-byte AES key encoded as 64 hexadecimal characters.
STORAGE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters-before-running-production

# Per-tenant node/MCP credential used only by the local demo seed.
TABLENOW_NODE_TOKEN=local-mcp-node-token-change-me-000000000000
TABLENOW_COMPUTER_NODE_TOKEN=local-computer-node-token-change-me-000000
TABLENOW_API_URL=http://core-api:4000

# Local encrypted export storage (replace with an S3-compatible adapter in cloud)
EXPORTS_DIR=/data/exports
COMPUTER_EVIDENCE_DIR=/data/computer-evidence
COMPUTER_SIMULATOR_URL=http://integration-simulator:4200
COMPUTER_RUNNER_API_URL=http://core-api:4000
COMPUTER_PROFILE_ROOT=/data/browser-profiles
COMPUTER_CHROMIUM_PATH=/usr/bin/chromium
COMPUTER_HEADLESS=true
COMPUTER_POLL_MS=2000
COMPUTER_MAX_MODEL_STEPS=30
# Optional visual fallback. Deterministic workflows remain available without it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPUTER_MODEL=gpt-5.6
DATA_RETENTION_MONTHS=24

# Optional local ↔ cloud synchronization
SYNC_ENABLED=false
SYNC_PORT=4100
