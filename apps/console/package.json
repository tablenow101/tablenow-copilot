    "test": "vitest run --passWithNoTests",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@tablenow/core-api": "workspace:*",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "rimraf": "^6.1.2",
    "vitest": "^4.1.11"
  }
}
